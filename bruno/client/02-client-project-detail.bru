meta {
  name: Détail d'un projet client — refusé à l'owner
  type: http
  seq: 2
}

get {
  url: {{apiUrl}}/client/projects/{{clientProjectId}}
  body: none
  auth: none
}

assert {
  res.status: eq 403
  res.body.error: eq Réservé aux accès clients
}

docs {
  ⚠️ TEST DE CLOISONNEMENT — lancé connecté en OWNER.
  La garde `requireClient` s'applique avant même la résolution du paramètre
  d'URL : la variable non renseignée n'a donc aucune incidence, on attend un 403.
}
