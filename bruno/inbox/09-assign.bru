meta {
  name: Poser la tâche sur le board
  type: http
  seq: 9
}

patch {
  url: {{apiUrl}}/tasks/{{inboxTaskId}}/assign
  body: json
  auth: none
}

body:json {
  {
    "project_id": "{{inboxProjectId}}",
    "column_id": "{{inboxColumnId}}"
  }
}

assert {
  res.status: eq 200
  res.body.stage: eq active
  res.body.project_id: eq {{inboxProjectId}}
  res.body.column_id: eq {{inboxColumnId}}
}

docs {
  Fin du pipeline : inbox → backlog → board. La tâche devient `active`, ce que
  la base garantit aussi (contrainte task_active_requires_board : une tâche
  active a forcément un projet ET une colonne).
}
