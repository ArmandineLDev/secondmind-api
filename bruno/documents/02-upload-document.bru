meta {
  name: Uploader un document
  type: http
  seq: 2
}

post {
  url: {{apiUrl}}/documents
  body: multipartForm
  auth: none
}

body:multipart-form {
  file: @file(./fixtures/exemple.pdf)
}

vars:post-response {
  documentId: res.body.id
}

docs {
  ⚠️ Requête manuelle : nécessite un fichier dans bruno/fixtures/.
  Envoie réellement sur Scaleway Object Storage — à ne pas lancer dans un
  run automatique du dossier (d'où l'absence d'assertion bloquante).
  Limites : 50 Mo, 1 fichier (multipart.plugin.ts), types MIME filtrés
  par ALLOWED_MIME_TYPES dans document.service.ts.
}
