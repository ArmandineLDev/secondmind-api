# Identifiants du compte de test sur la base LOCALE uniquement.
# Copier ce fichier en .env (gitignoré) et y mettre vos vraies valeurs.
# Ne jamais committer .env, ni mettre d'identifiants en dur dans un .bru.
TEST_EMAIL=vous@exemple.dev
TEST_PASSWORD=votre-mot-de-passe-local

# Compte CLIENT de test, pour le dossier zz-cloisonnement-client uniquement.
# L'inscription publique étant fermée, créer ce compte à la main en base puis
# l'inviter via Paramètres → Accès clients.
TEST_CLIENT_EMAIL=client@exemple.dev
TEST_CLIENT_PASSWORD=mot-de-passe-client-local
