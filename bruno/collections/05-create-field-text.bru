meta {
  name: Ajouter une colonne texte
  type: http
  seq: 5
}

post {
  url: {{apiUrl}}/collections/{{collectionId}}/fields
  body: json
  auth: none
}

body:json {
  {
    "name": "Prix",
    "type": "text"
  }
}

vars:post-response {
  priceFieldId: res.body.id
}

assert {
  res.status: eq 201
  res.body.type: eq text
  res.body.options: isNull
  res.body.position: eq 0
}

docs {
  La position est calculée en base (MAX + 1) : une nouvelle colonne se pose
  toujours à droite des existantes, sans que le front ait à la deviner.
}
