meta {
  name: Lister les opportunités
  type: http
  seq: 12
}

get {
  url: {{apiUrl}}/opportunities?stage=qualification
  body: none
  auth: none
}

params:query {
  stage: qualification
  ~contact_id: {{contactId}}
  ~company_id: {{companyId}}
}

assert {
  res.status: eq 200
  res.body: isArray
}
