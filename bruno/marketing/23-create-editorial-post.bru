meta {
  name: Créer un post éditorial
  type: http
  seq: 23
}

post {
  url: {{apiUrl}}/editorial-posts
  body: json
  auth: none
}

body:json {
  {
    "network": "linkedin",
    "status": "scheduled",
    "title": "[Bruno] Retour d'expérience",
    "content": "Ce que m'a appris la construction de mon propre outil.",
    "persona_id": "{{personaId}}",
    "scheduled_at": "2026-09-10T09:00:00.000Z",
    "tags": ["produit", "freelance"]
  }
}

vars:post-response {
  postId: res.body.id
}

assert {
  res.status: eq 201
  res.body.network: eq linkedin
}

docs {
  scheduled_at attend un datetime ISO complet (z.string().datetime()),
  pas une simple date.
}
