meta {
  name: Sign In
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/auth/sign-in/email
  body: json
  auth: none
}

headers {
  Origin: {{baseUrl}}
}

body:json {
  {
    "email": "{{process.env.TEST_EMAIL}}",
    "password": "{{process.env.TEST_PASSWORD}}"
  }
}

assert {
  res.status: eq 200
}

docs {
  Doit tourner en premier : dépose le cookie de session réutilisé par
  toutes les autres requêtes de la collection.
  Identifiants lus depuis bruno/.env (voir .env.example).
}
