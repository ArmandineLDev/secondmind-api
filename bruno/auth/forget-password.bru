meta {
  name: Forget Password
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/auth/forget-password
  body: json
  auth: none
}

headers {
  Origin: {{baseUrl}}
}

body:json {
  {
    "email": "{{process.env.TEST_EMAIL}}",
    "redirectTo": "/reset-password"
  }
}

assert {
  res.status: eq 200
}

docs {
  Anti-énumération : répond 200 même si l'email est inconnu.
  Un envoi Brevo réel est déclenché si le compte existe.
}
